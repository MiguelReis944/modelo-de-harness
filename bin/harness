#!/usr/bin/env bash
# harness — ferramental deste harness (Claude Code), workspace/ em git submodules
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CFG="$ROOT/harness.config.yaml"
cd "$ROOT"

# extrai itens de uma lista YAML simples sob uma chave top-level (ver bin/yaml_list.py)
yaml_list() { # $1=key $2=file
  python3 "$ROOT/bin/yaml_list.py" "$1" "$2"
}

cmd_sync() {
  # Copia (nao symlink): criar symlink no Windows exige Modo Desenvolvedor/admin, e um
  # symlink que falha silenciosamente vira copia estatica desatualizada sem avisar.
  # Rode este comando de novo sempre que editar catalog/skills/, agents/ ou mcp/servers.json.
  local skills agents
  skills=$(yaml_list active_skills "$CFG")
  agents=$(yaml_list active_agents "$CFG")

  cp -f AGENTS.md CLAUDE.md
  echo "  CLAUDE.md <- AGENTS.md (copia)"

  rm -rf .claude/skills .claude/agents
  mkdir -p .claude/skills .claude/agents
  for s in $skills; do cp -r "catalog/skills/$s" ".claude/skills/$s"; done
  for a in $agents; do cp -f "agents/$a/AGENT.md" ".claude/agents/$a.md"; done
  python3 bin/render_mcp.py mcp/servers.json > .mcp.json
  python3 bin/render_settings.py hooks/hooks.json .claude/settings.json
  echo "  claude:  .claude/skills/* .claude/agents/* .mcp.json .claude/settings.json (hooks)"
  echo "sync ok."
}

cmd_doctor() {
  local skills agents ok=0
  skills=$(yaml_list active_skills "$CFG")
  agents=$(yaml_list active_agents "$CFG")

  echo "== binarios =="
  command -v claude >/dev/null && echo "  claude: ok" || echo "  claude: faltando (npm i -g @anthropic-ai/claude-code)"

  echo "== skills ativas =="
  for s in $skills; do
    if [ -f "catalog/skills/$s/SKILL.md" ]; then echo "  $s: ok"; else echo "  $s: SKILL.md AUSENTE"; ok=1; fi
  done

  echo "== sub-agentes =="
  for a in $agents; do
    if [ -f "agents/$a/AGENT.md" ]; then echo "  $a: ok"; else echo "  $a: AGENT.md AUSENTE"; ok=1; fi
  done

  echo "== submodules (workspace/) =="
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "  (fora de um repositorio git — secao ignorada)"
  elif [ -z "$(git submodule status 2>/dev/null)" ]; then
    echo "  (nenhum submodule registrado — use 'harness new-project')"
  else
    git submodule status | while read -r line; do
      case "$line" in
        -*) echo "  NAO INICIALIZADO: ${line#-}";;
        +*) echo "  COMMIT DIVERGENTE DO REGISTRADO: ${line#+}";;
        *)  echo "  ok: ${line# }";;
      esac
    done
  fi

  echo "== documentacao dos projetos =="
  python3 "$ROOT/bin/project_docs.py" check "$ROOT/workspace" || ok=1

  echo "== hooks =="
  if [ -f hooks/hooks.json ] && [ -f .claude/settings.json ]; then
    python3 -c "
import json
h = json.load(open('.claude/settings.json', encoding='utf-8')).get('hooks', {})
if 'SessionStart' in h:
    print('  SessionStart: ok (' + h['SessionStart'][0]['hooks'][0]['command'] + ')')
else:
    print('  SessionStart: AUSENTE em .claude/settings.json (rode bin/harness sync)')
"
  else
    echo "  hooks/hooks.json ou .claude/settings.json ausente (rode bin/harness sync)"
  fi

  echo "== MCP =="
  python3 - "mcp/servers.json" << 'PY'
import json,sys
d=json.load(open(sys.argv[1]))
for n,s in d.get("servers",{}).items():
    st="ENABLED" if s.get("enabled") else "off"
    print(f"  {n}: {st} ({s.get('transport','stdio')}) - auth: {s.get('auth','-')}")
print("  lembrete: credenciais sao locais (env / *.local.json), nunca no repo.")
PY
  return $ok
}

cmd_skills() {
  echo "== catalogo =="; ls -1 catalog/skills
  echo "== ativas =="; yaml_list active_skills "$CFG"
}

project_manifest() { # $1=check|append $2=name $3=url
  python3 - "$@" <<'PY'
import json
from pathlib import Path
import re
import sys

mode, name, url = sys.argv[1:]
if name in (".", "..") or any(char in "/\\" or ord(char) < 32 for char in name):
    sys.exit("nome invalido: use uma unica pasta, sem separadores ou caracteres de controle")

manifest = Path("workspace.yaml")
with manifest.open("r", encoding="utf-8", newline="") as source:
    content = source.read()
lines = content.splitlines(keepends=True)
headers = [index for index, line in enumerate(lines) if line.startswith("projects:")]
if len(headers) != 1:
    sys.exit("workspace.yaml invalido: esperado um unico campo projects: no nivel principal")

index = headers[0]
header = lines[index].rstrip("\r\n")
match = re.fullmatch(r"projects:[ \t]*(\[\])?[ \t]*(#.*)?", header)
if not match:
    sys.exit("workspace.yaml invalido: projects deve ser uma lista ou projects: []")
end = index + 1
while end < len(lines) and (not lines[end] or lines[end][0] in " \t#\r\n"):
    end += 1
items = [line for line in lines[index + 1:end] if line.strip() and not line.lstrip().startswith("#")]
if match.group(1) and items:
    sys.exit("workspace.yaml invalido: projects: [] contem itens adicionais")
if items and not items[0].startswith("  - "):
    sys.exit("workspace.yaml invalido: projects deve conter itens de lista com recuo de dois espacos")
if mode == "check":
    sys.exit(0)

newline = "\r\n" if "\r\n" in content else "\n"
if match.group(1):
    comment = match.group(2)
    lines[index] = "projects:" + (" " + comment if comment else "") + newline
    end = index + 1
entry = (newline + "  - name: " + json.dumps(name) + newline
         + "    path: " + json.dumps("workspace/" + name) + newline
         + "    repo: " + json.dumps(url) + newline)
lines.insert(end, entry)
with manifest.open("w", encoding="utf-8", newline="") as output:
    output.write("".join(lines))
PY
}

cmd_new_project() {
  local name="${1:-}" url="${2:-}" quoted_project
  [ -n "$name" ] && [ -n "$url" ] || { echo "uso: harness new-project <nome> <git-url>"; exit 1; }
  project_manifest check "$name" "$url"
  git submodule add "$url" "workspace/$name"
  python3 "$ROOT/bin/project_docs.py" init "workspace/$name"
  project_manifest append "$name" "$url"
  printf -v quoted_project '%q' "workspace/$name"
  echo "adicionado como submodule: workspace/$name"
  echo "documentacao inicial preparada em workspace/$name/docs/"
  echo "commite os documentos no repositorio do projeto:"
  printf '  (cd %s && git add -- docs AGENTS.md && git commit -m %q)\n' "$quoted_project" 'Add project documentation'
  echo "edite workspace.yaml (domain/type/summary, se quiser); depois registre o submodule no harness:"
  printf '  git add -- .gitmodules %s workspace.yaml\n' "$quoted_project"
  printf '  git commit -m %q\n' "add $name as submodule"
}

cmd_update_projects() {
  git submodule update --remote --merge
  echo ""
  echo "Submodules atualizados. Revise 'git status' e, se quiser fixar essas"
  echo "novas versões no harness:"
  echo "  git add workspace/"
  echo "  git commit -m \"bump submodules\""
}

case "${1:-help}" in
  sync)            cmd_sync ;;
  doctor)          cmd_doctor ;;
  skills)          cmd_skills ;;
  new-project)     shift; cmd_new_project "$@" ;;
  update-projects) cmd_update_projects ;;
  *) cat <<USAGE
harness — ferramental do harness
  sync                       projeta skills/agents/mcp/hooks pro Claude Code (.claude/, .mcp.json)
  doctor                     confere binarios, skills, sub-agentes, MCP, submodules e documentos
  skills                     lista catalogo vs ativo
  new-project <nome> <url>   adiciona repo como submodule em workspace/
  update-projects            atualiza todos os submodules pro commit mais recente do remoto
USAGE
  ;;
esac
